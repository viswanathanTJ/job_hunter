# Apify (LinkedIn jobs scraper) — same actor the old n8n workflow used
APIFY_TOKEN=
APIFY_ACTOR=curious_coder~linkedin-jobs-scraper

# Search config (defaults match the old n8n workflow)
JOB_SEARCH_QUERY=Backend Engineer OR Senior Backend Engineer
LOOKBACK_HOURS=24
FETCH_COUNT=10

# Server
PORT=4680

# Claude headless processing (uses your Claude Code subscription via `claude -p`)
CLAUDE_MODEL=sonnet

# Resume output
RESUME_PDF_NAME=Viswanathan-T-J-Resume.pdf
